{
  "name": "@juit/vue-z",
  "description": "Widgets Libray for Juit GmbH",
  "version": "0.2.8",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "scripts": {
    "build": "plug",
    "build-demo": "plug tsc lint vite vite_config_file=vite.config.demo.ts",
    "dev": "vite -c vite.config.demo.ts"
  },
  "peerDependencies": {
    "@juit/vue-i18n": "^1.1.1",
    "@quasar/extras": "^2.1.0",
    "quasar": "^2.35.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.60.0",
    "@plugjs/eslint": "^0.7.15",
    "@plugjs/eslint-plugin": "^0.7.16",
    "@plugjs/plug": "^0.7.15",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/google.maps": "^3.66.9",
    "@types/node": "<25",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint-plugin-vue": "^10.12.0",
    "sass-embedded": "^1.107.0",
    "typescript": "<7",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "@quasar/vite-plugin": {
